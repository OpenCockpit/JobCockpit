- param: {name: "width"}
- param: {name: "height"}
- widget:
    backgroundColorSelected: "$backgroundColorSelected"
    foregroundColorSelected: "$foregroundColorSelected"
    itemCornerRadiusSelected: "$radius_item"
    position: "0,0"
    render: "Listbox"
    size: "$width,eval($height/80*80)"
    source: "list"
    children:
      - convert:
          type: "COCTemplatedMultiContentEx"
          cell:
            itemHeight: 80
            fonts:
              - "$md_body_small"
            fields:
              - text:
                  position: "10,0"
                  size: "$width-20,40"
                  font: "$md_body_small"
                  flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
                  value: 0
              - text:
                  position: "10,40"
                  size: "200,40"
                  font: "$md_body_small"
                  flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
                  value: 1
              - progress:
                  position: "250,50"
                  size: "1300,20"
                  value: -2
                  borderWidth: 1
              - text:
                  position: "$width-100-10,40"
                  size: "100,40"
                  font: "$md_body_small"
                  flags: RT_HALIGN_RIGHT|RT_VALIGN_CENTER
                  value: 3
