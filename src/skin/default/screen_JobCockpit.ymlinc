screen:
  name: "JobCockpit"
  position: "center,center"
  size: "1416,700"
  children:
    - xmlinc:
        file: "screenpart_TitleBar.ymlinc"
    - widget:
        backgroundColorSelected: "$backgroundColorSelected"
        foregroundColorSelected: "$foregroundColorSelected"
        itemCornerRadiusSelected: "$radius_item"
        position: "10,65"
        render: "Listbox"
        scrollbarMode: "showOnDemand"
        size: "e-20,570"
        source: "list"
        transparent: "1"
        children:
          - convert:
              type: "TemplatedMultiContentEx"
              cell:
                itemHeight: 80
                fonts:
                  - "$md_body_small"
                fields:
                  - text:
                      position: "10,0"
                      size: "1000,40"
                      font: "$md_body_small"
                      flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
                      value: 0
                  - text:
                      position: "10,40"
                      size: "200,40"
                      font: "$md_body_small"
                      flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
                      value: 1
                  - progress:
                      position: "250,50"
                      size: "1000,20"
                      value: -2
                      borderWidth: 1
                  - text:
                      position: "1266,40"
                      size: "100,40"
                      font: "$md_body_small"
                      flags: RT_HALIGN_RIGHT|RT_VALIGN_CENTER
                      value: 3
    - xmlinc:
        file: "screenpart_Footer.ymlinc"
