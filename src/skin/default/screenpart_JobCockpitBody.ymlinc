- param: {name: "width"}
- param: {name: "height"}
# the jobs: a row a job, its name over the whole row, under it its state, its progress bar and the percentage of it
- widget:
    render: "Listbox"
    backgroundColorSelected: "$backgroundColorSelected"
    foregroundColorSelected: "$foregroundColorSelected"
    itemCornerRadiusSelected: "$radius_item"
    position: "0,0"
    size: "$width,eval($height/80*80)"
    source: "list"
    children:
      - convert:
          type: "COCTemplatedMultiContentEx"
          cell:
            itemHeight: 80
            fonts: ["$md_body_small"]
            fields:
              - text:
                  font: "$md_body_small"
                  flags: "RT_HALIGN_LEFT|RT_VALIGN_CENTER"
                  value: 0
                  position: "10,0"
                  size: "240+1300+($width-10-10)-240-1300,40"
              - text:
                  font: "$md_body_small"
                  flags: "RT_HALIGN_LEFT|RT_VALIGN_CENTER"
                  value: 1
                  position: "10,40"
                  size: "200,40"
              - rect:
                  backgroundColor: "md_surface_container_highest"
                  backgroundColorSelected: "md_outline"
                  cornerRadius: 10
                  position: "250,50"
                  size: "1300,20"
              - progress:
                  value: -2
                  foreColor: "md_primary"
                  foreColorSelected: "md_inverse_primary"
                  cornerRadius: 10
                  position: "250,50"
                  size: "1300,20"
              - text:
                  font: "$md_body_small"
                  flags: "RT_HALIGN_RIGHT|RT_VALIGN_CENTER"
                  value: 3
                  position: "1550+($width-10-10)-240-1300-100,40"
                  size: "100,40"
